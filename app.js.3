  document.querySelectorAll('.plat-opt').forEach(function(el){
    el.classList.toggle('active',el.getAttribute('data-plat')===state.platform);
  });
  updateBalanceUI();
  refreshTip();
  loadScrapeScript();
  setupBookmarkDrag();
  document.querySelectorAll('.mask').forEach(function(m){
    m.addEventListener('click',function(e){ if(e.target===m) m.classList.add('hidden'); });
  });
})();
