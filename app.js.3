/* 二维码识别 */
$('qrInput').addEventListener('change',function(){
  var f=this.files&&this.files[0]; this.value='';
  if(!f) return;
  var rd=new FileReader();
  rd.onload=function(){
    var img=new Image();
    img.onload=function(){
      var c=document.createElement('canvas'); c.width=img.width; c.height=img.height;
      var ctx=c.getContext('2d'); ctx.drawImage(img,0,0);
      var id=ctx.getImageData(0,0,c.width,c.height);
      var code=null;
      try{ if(window.jsQR) code=jsQR(id.data,id.width,id.height); }catch(e){}
      if(code&&code.data){
        var txt=String(code.data).trim();
        var isUrl=/^https?:\/\//i.test(txt);
        $('qrResult').innerHTML='<span style="color:#16A34A;">✅ 已识别'+(isUrl?'链接':'内容')+'：'+esc(txt.slice(0,60))+'</span>';
        window.__scrapeQR=txt;
        if(isUrl) $('shopLink').value=txt;
      }else{
        $('qrResult').innerHTML='<span style="color:#B45309;">⚠️ 二维码未能自动识别，可改为粘贴链接</span>';
        window.__scrapeQR='';
      }
    };
    img.src=rd.result;
  };
  rd.readAsDataURL(f);
});
/* 清洗粘贴文本，提取真正的店铺链接/口令（防止把上次的任务文本反复贴回导致重复累积） */
function cleanLink(raw){
  var s=String(raw||'').trim();
  if(!s) return '';
  /* 如果粘贴的是整段任务文本，提取其中第一个 http(s) 链接 */
  var m=s.match(/https?:\/\/[^\s）)】》《<>"']+/);
  if(m) return m[0].replace(/[，。、；;]+$/,'');
  /* 其他情况原样返回（可能是口令原文） */
  return s;
}
/* 确认抓取 */
function confirmScrape(){
  var mode=(document.querySelector('input[name=scrapeMode]:checked')||{}).value||'menu';
  var note=($('scrapeNotes')||{}).value||'';
  var link=cleanLink(($('shopLink')||{}).value);
  var qr=window.__scrapeQR||'';
  if(!link&&!qr){ toast('请先上传店铺二维码或粘贴店铺链接'); return; }
  var mname=mode==='menu'?'仅菜单':(mode==='img'?'仅菜品图':'全部打包');
  state.scrapeRecords=state.scrapeRecords||[];
  state.scrapeRecords.unshift({id:'t'+Date.now(),type:'task',mode:mode,mname:mname,note:note,link:link||qr,t:nowStr(),status:'待抓取'});
  saveState(); renderScrapeRecords();
  /* 生成任务信息，一键复制发给助手 */
  var msg='【商家调研抓取任务】\n抓取内容：'+mname+'\n店铺链接：'+(link||qr)+'\n'+(note?'说明：'+note+'\n':'')+'请开始抓取';
  var box=$('scrapeTaskMsg'), txt=$('scrapeTaskMsgText');
  if(box&&txt){ txt.textContent=msg; box.style.display='block'; }
  copyText(msg);
  /* 生成后清空输入框与识别结果，防止反复点击重复累积 */
  if($('shopLink')) $('shopLink').value='';
  window.__scrapeQR='';
  if($('qrResult')) $('qrResult').innerHTML='';
  /* 只有纯 http 链接才尝试打开；口令类由助手解析 */
  if(/^https?:\/\//i.test(link||'')) window.open(link,'_blank');
}
function copyTaskMsg(){
  var txt=$('scrapeTaskMsgText').textContent||'';
  if(txt) copyText(txt);
}
function arrayBufferToBase64(buf){
  var bytes=new Uint8Array(buf), binary='';
  for(var i=0;i<bytes.byteLength;i++) binary+=String.fromCharCode(bytes[i]);
  return btoa(binary);
}
function renderScrapeRecords(){
  var list=state.scrapeRecords||[];
  var el=$('scrapeRecordList');
  if(!el) return;
  el.innerHTML=list.length?list.map(function(r,i){
    var action='';
    if(r.type==='menu') action='<button class="btn-blue-ghost" style="padding:2px 8px;font-size:11px;" onclick="useScrapeMenu('+i+')">导入分析</button> <button class="btn-ghost" style="padding:2px 8px;font-size:11px;" onclick="downloadScrape('+i+')">下载</button>';
    else if(r.type==='zip') action='<button class="btn-ghost" style="padding:2px 8px;font-size:11px;" onclick="downloadScrape('+i+')">下载zip</button>';
    else action='<span style="color:var(--text3);font-size:11px;">待抓取</span>'+((r.link||'').indexOf('http')===0?' <a style="color:var(--primary);font-size:11px;cursor:pointer;" onclick="window.open(\''+r.link+'\')">打开店铺</a>':'');
    return '<div class="hist-item"><div><div class="h-name">'+esc(r.mname||r.name||'实抓记录')+'</div>'+
      '<div style="font-size:11px;color:var(--text3);">'+(r.note?esc(r.note):'')+(r.count?' ｜ 商品 '+r.count+' 项':'')+(r.size?' ｜ '+r.size:'')+'</div></div>'+
      '<span style="display:flex;gap:4px;align-items:center;font-size:11px;color:var(--text3);">'+esc(r.t)+' '+action+'</span></div>';
  }).join(''):'<p style="font-size:12px;color:var(--text3);text-align:center;padding:14px 0;">暂无实抓记录</p>';
}
$('scrapeImportInput').addEventListener('change',function(){
  var f=this.files&&this.files[0]; this.value='';
  if(!f) return;
  var ext=(f.name||'').split('.').pop().toLowerCase();
  if(ext==='zip'){
    var url=URL.createObjectURL(f);
    window.__zipURLs=window.__zipURLs||{};
    state.scrapeRecords.unshift({id:'z'+Date.now(),type:'zip',mname:'菜品图打包',name:f.name,size:fmtSize(f.size),t:nowStr(),url:url});
    saveState(); renderScrapeRecords(); toast('已导入图片包：'+f.name);
    return;
  }
  if(ext==='xlsx'||ext==='xls'){
    var rd=new FileReader();
    rd.onload=function(){
      var b64=arrayBufferToBase64(rd.result);
      state.scrapeRecords.unshift({id:'m'+Date.now(),type:'menu',mname:'用户端实抓菜单',name:f.name,size:fmtSize(f.size),t:nowStr(),data:b64});
      saveState(); renderScrapeRecords(); toast('已导入菜单文件，可点「导入分析」用于菜单优化');
    };
    rd.readAsArrayBuffer(f);
    return;
  }
  toast('仅支持 .xlsx / .xls / .zip');
});
function fmtSize(b){ b=b||0; return b>1048576?(b/1048576).toFixed(1)+'MB':(b/1024).toFixed(0)+'KB'; }
function downloadScrape(i){
  var r=state.scrapeRecords[i]; if(!r) return;
  if(r.type==='zip'){ if(r.url){ var a=document.createElement('a'); a.href=r.url; a.download=r.name||'菜品图.zip'; a.click(); } return; }
  if(r.type==='menu'&&r.data){
    var bin=atob(r.data), len=bin.length, u8=new Uint8Array(len);
    for(var k=0;k<len;k++) u8[k]=bin.charCodeAt(k);
    var blob=new Blob([u8],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    var url=URL.createObjectURL(blob); var a=document.createElement('a'); a.href=url; a.download=r.name||'实抓菜单.xlsx'; a.click();
  }
}
function useScrapeMenu(i){
  var r=state.scrapeRecords[i]; if(!r||!r.data){ toast('无菜单数据'); return; }
  var bin=atob(r.data), len=bin.length, u8=new Uint8Array(len);
  for(var k=0;k<len;k++) u8[k]=bin.charCodeAt(k);
  var f=new File([u8], r.name||'实抓菜单.xlsx', {type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
  readSheetArray(f).then(function(rows){
    var res=parseMenuFile(rows);
    if(res&&res.ok&&res.products&&res.products.length){
      state.menu={file:f,rows:rows,parsed:res,name:r.name||'实抓菜单.xlsx'};
      RECOGNIZED.menu=res;
      saveState();
      $('menuItem').classList.remove('hidden'); $('menuZone').classList.add('hidden');
      $('menuName').textContent=f.name; $('menuSize').textContent=fmtSize(f.size);
      var box=$('menuRecog');
      if(box){ box.className='recog-box'; box.innerHTML='<div class="r-title">✅ 已导入用户端实抓菜单：'+res.found.join('、')+'，共 '+res.products.length+' 个商品</div><div class="recog-list">'+res.found.map(function(x){return '<span>'+x+'</span>';}).join('')+'</div>'; box.classList.remove('hidden'); }
      updateStartBtn();
      toast('已导入实抓菜单用于分析（'+res.products.length+' 项，含月售）');
    } else {
      toast('菜单解析失败，请检查文件格式');
    }
  })['catch'](function(){ toast('菜单解析失败，请检查文件格式'); });
}

