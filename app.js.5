/* ============================================================
   餐谋长 · v0.26：自动抓取脚本检测升级（零安装书签方案）
   覆盖 app.js.3 中的 detectScraper：
   - 已装油猴脚本 -> 显示「✅ 全自动」
   - 未装 -> 显示「⭐ 按住拖到书签栏」（零安装），拖动即完成，进店后点一下即自动抓取
   ============================================================ */
function detectScraper(){
  var st=document.getElementById('scrapePluginState');
  if(!st) return;
  var installed=document.documentElement.getAttribute('data-cmz-scraper')==='installed';
  var area=document.getElementById('scrapeInstallArea');
  if(installed){
    st.textContent='✅ 已安装';
    st.style.color='#16A34A';
    if(area) area.innerHTML='<span style="color:#16A34A;font-weight:600;">全自动：粘贴口令进店即自动抓取下载</span>';
  }else{
    st.textContent='未安装';
    st.style.color='#B45309';
    if(area){
      area.innerHTML='<a id="bookmarkDragV3" draggable="true" style="display:inline-block;background:#16A34A;color:#fff;font-size:12px;font-weight:600;padding:6px 12px;border-radius:8px;cursor:grab;text-decoration:none;margin-right:8px;" href="javascript:void(0)">⭐ 按住我拖到书签栏</a><span style="color:var(--text3);">零安装。进店后点一下书签即自动抓取。</span>';
      var bm=document.getElementById('bookmarkDragV3');
      if(bm&&!bm.getAttribute('data-set')){
        bm.setAttribute('data-set','1');
        bm.href='javascript:(function(){fetch(\'https://2169913411-afk.github.io/scrape-inject.js?v=20260828.2\').then(function(r){return r.text()}).then(function(t){eval(t)}).catch(function(){alert(\'抓取脚本加载失败，请检查网络后重试\')})})();';
      }
    }
  }
}
/* v0.28：Lucide 图标初始化（页面结构渲染完成后调用） */
function initLucide(){
  if(window.lucide){
    try{ lucide.createIcons(); }catch(e){ console.error('lucide init',e); }
  }
}
document.addEventListener('DOMContentLoaded', function(){ setTimeout(initLucide, 60); });
setTimeout(initLucide, 800);
