/* ---------- AI 调用（OpenAI 兼容 / 智谱） ---------- */
function callLLM(url,key,model,messages,timeout,maxTokens){
  var controller=(typeof AbortController!=='undefined')?new AbortController():null;
  var timer=controller?setTimeout(function(){controller.abort();},(timeout||180)*1000):null;
  var opt={method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
    body:JSON.stringify({model:model,messages:messages,temperature:0.3,max_tokens:maxTokens||12000})};
  if(controller) opt.signal=controller.signal;
  return fetch(url,opt).then(function(res){
    if(timer) clearTimeout(timer);
    if(!res.ok) return res.text().then(function(t){ throw new Error('HTTP '+res.status+' '+String(t).slice(0,200)); });
    return res.json();
  }).then(function(data){
    var c=data&&data.choices&&data.choices[0]&&data.choices[0].message&&data.choices[0].message.content;
    if(!c) throw new Error('模型返回为空');
    return c;
  });
}
function getApi(){
  return {baseUrl:(state.api.baseUrl||API_DEFAULT.baseUrl).trim().replace(/\/+$/,''),
          apiKey:(state.api.apiKey||'').trim(),
          model:(state.api.model||API_DEFAULT.model).trim(),
          visionModel:(state.api.visionModel||API_DEFAULT.visionModel).trim(),
          timeout:state.api.timeout||180};
}
function parseJson(txt){
  txt=String(txt||'').trim();
  try{ return JSON.parse(txt); }catch(e){}
  var m=txt.match(/```(?:json)?\s*([\s\S]*?)```/); if(m){ try{ return JSON.parse(m[1].trim()); }catch(e2){} }
  var s=txt.indexOf('{'), en=txt.lastIndexOf('}');
  if(s>-1&&en>s){ try{ return JSON.parse(txt.slice(s,en+1)); }catch(e3){} }
  throw new Error('无法解析模型返回的JSON');
}

/* ---------- 上传 ---------- */
function setupZone(zoneId,inputId,handler){
  var zone=$(zoneId), input=$(inputId);
  zone.addEventListener('click',function(){ input.click(); });
  input.addEventListener('change',function(){ handler(input.files); input.value=''; });
  zone.addEventListener('dragover',function(e){ e.preventDefault(); zone.classList.add('drag'); });
  zone.addEventListener('dragleave',function(){ zone.classList.remove('drag'); });
  zone.addEventListener('drop',function(e){
    e.preventDefault(); zone.classList.remove('drag');
    if(e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files.length) handler(e.dataTransfer.files);
  });
}
