/* 评价数据文件：识别差评 */
function parseReviewFile(rows){
  var headIdx=-1, head=null;
  for(var i=0;i<Math.min(rows.length,6);i++){
    var h=cleanHead(rows[i]||[]);
    if(h.some(function(x){return x.indexOf('评价内容')>-1||x.indexOf('总体评分')>-1;})){ headIdx=i; head=h; break; }
  }
  if(headIdx<0) return {ok:false,msg:'未识别到评价表头'};
  function findCol(keys){
    for(var i=0;i<head.length;i++){ for(var j=0;j<keys.length;j++){ if(head[i]&&head[i].indexOf(keys[j])>-1) return i; } }
    return -1;
  }
  var idxScore=findCol(['总体评分','综合评分','评分']);
  var idxContent=findCol(['评价内容','评论内容','内容']);
  var idxDate=findCol(['日期','评价时间']);
  var idxItems=findCol(['点赞商品','点踩商品','订单']);
  if(idxScore<0&&idxContent<0) return {ok:false,msg:'未找到评分或评价内容列'};
  var all=[], bad=[];
  for(var r=headIdx+1;r<rows.length;r++){
    var row=rows[r]||[];
    if(!row.some(function(c){return c!=null&&String(c).trim()!=='';})) continue;
    var score=idxScore>-1?num(row[idxScore]):null;
    var content=idxContent>-1?(row[idxContent]==null?'':String(row[idxContent]).trim()):'';
    if(!content&&score==null) continue;
    var item={score:score,content:content,
      date:idxDate>-1?(row[idxDate]==null?'':String(row[idxDate])):'',
      order:idxItems>-1?(row[idxItems]==null?'':String(row[idxItems])):''};
    all.push(item);
    var isBad=false;
    if(score!=null&&score>0&&score<=3) isBad=true;
    else if(score==null&&/难吃|变质|不好吃|恶心|避雷|差评|投诉|失望|太差|腥味|软烂|分量少|不值|后悔/.test(content)) isBad=true;
    if(isBad) bad.push(item);
  }
  return {ok:true,total:all.length,bad:bad};
}
