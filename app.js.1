  if(!el) return;
  el.addEventListener('mouseenter',function(){ pasteTarget=key; el.classList.add('paste-target'); });
  el.addEventListener('mouseleave',function(){ if(pasteTarget===key){ pasteTarget=null; el.classList.remove('paste-target'); } });
