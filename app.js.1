      box.className='recog-box';
      box.innerHTML='<div class="r-title">已识别 '+res.found.join('、')+'，共 '+res.products.length+' 个商品</div>'+
        '<div class="recog-list">'+res.found.map(function(x){return '<span>'+x+'</span>';}).join('')+'</div>'+
        (missing.length?'<div style="color:#B45309;margin-top:4px;">未识别列：'+missing.join('、')+'</div>':'')+
        '<div style="margin-top:2px;">分组数：'+res.groupCount+'</div>';
    }else{
      box.className='recog-box err';
