/* ---------- 数据完整度预检（免费） ---------- */
function buildStructured(){
  var data={};
  var shopParsed=(state.shop&&state.shop.parsed)||null;
  if(shopParsed&&shopParsed.ok){
    data.shop_base=shopParsed.shop_base;
    if(!data.shop_base.platform) data.shop_base.platform=state.platform||'淘宝闪购';
    if(shopParsed.flow) data.flow=shopParsed.flow; // 本店流量转化（文件聚合，精确值）
  }
  if(state.menu&&state.menu.parsed&&state.menu.parsed.ok) data.products=state.menu.parsed.products;
  if(state.review&&state.review.parsed&&state.review.parsed.ok){
    var bad=state.review.parsed.bad||[];
    var total=state.review.parsed.total||0;
    var orders=(data.shop_base&&data.shop_base.valid_orders)||0;
    // 优先用门店数据文件中的"差评订单数"（平台统计口径，准确），评价文件中的差评数仅作列表展示
    var shopBadOrders=(data.shop_base&&data.shop_base.bad_orders!=null)?data.shop_base.bad_orders:bad.length;
    data.bad_reviews={
      total:bad.length,
      by_orders:shopBadOrders,
      by_orders_rate:orders?Math.round((shopBadOrders/orders)*10000)/10000:null,
      list:bad.slice(0,30)
    };
  }
  if(shopParsed&&shopParsed.colMap){
    data.activity={
      full_discount:[],
      subsidy_rate:(data.shop_base&&data.shop_base.subsidy_rate)||null,
      subsidy_total:(data.shop_base&&data.shop_base.subsidy)||null
    };
  }
  if(!data.flow) data.flow={}; // 无文件流量列时由 vision 填充
  data.frontend_experience={has_qr:!!(state.qr&&state.qr.file)};
  return data;
}
function completenessCheck(){
  var miss=[];
  var shopOk=!!(state.shop&&state.shop.parsed&&state.shop.parsed.ok);
  var hasFlow=shopOk&&state.shop.parsed.hasFlow;
  var needMenu=!(state.menu&&state.menu.parsed&&state.menu.parsed.ok);
  var needReview=!(state.review&&state.review.parsed&&state.review.parsed.ok);
  var needPeer=!(state.peer&&state.peer.length);
  var needQr=!(state.qr&&state.qr.file);
  if(needQr) miss.push('门店二维码（必选）：用于模拟顾客进店排查前端体验');
  if(!shopOk) miss.push('门店数据文件（必选）：缺少 有效订单/营业额/收入/单均实付 等经营数据');
  else if(!hasFlow) miss.push('门店数据文件缺少 曝光/进店/下单/转化 列：本店流量转化数据不足');
  if(needPeer) miss.push('同行数据以及重要截图：缺少 同行 的全部/新客/老客 曝光与入店、下单转化对比值');
  if(needMenu) miss.push('菜单数据文件：缺少商品明细，将无法做菜单优化与导出');
  if(needReview) miss.push('门店评价数据：缺少差评明细，将无法做差评专项分析');
  return {miss:miss,count:miss.length};
}

/* ---------- 开始分析流程 ---------- */
var analyzing=false;
function onStart(){
  if(!state.api.apiKey){ state.api.apiKey=API_DEFAULT.apiKey; }
  var plan=getPlan();
  if(!plan){ toast('请选择分析功能'); return; }
  if(state.points<plan.cost){
    $('needPoints').textContent=plan.cost;
    openModal('insufficientMask'); return;
  }
  // 完整度预检（免费）
  openModal('checkingMask');
  setTimeout(function(){
    var chk=completenessCheck();
    closeModal('checkingMask');
    $('precheckBody').innerHTML=
      (chk.count?'<div class="warn-list"><div class="w-title">检测到以下数据缺失，可能影响分析精准度：</div><ul>'+chk.miss.map(function(m){return '<li>'+m+'</li>';}).join('')+'</ul></div>'
                 :'<p style="font-size:13px;color:#166534;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:8px;padding:12px;">✅ 核心数据已齐备，可直接开始分析。</p>');
    openModal('precheckMask');
  },500);
}
function proceedAnalysis(){
  closeModal('precheckMask');
  $('confirmPoints').textContent=getPlan().cost;
  openModal('confirmMask');
}
function doAnalysis(){
  closeModal('confirmMask');
  var plan=getPlan();
  if(state.points<plan.cost){ openModal('insufficientMask'); return; }
  // 扣积分
  state.points-=plan.cost;
  state.pointsLog.unshift({t:nowStr(),delta:'-'+plan.cost,note:plan.name,balance:state.points});
  saveState(); updateBalanceUI();
  renderLoading('AI正在解析店铺数据，生成外卖运营方案，请稍候');
  runAnalysis(plan);
}
function renderLoading(msg){
  var area=$('resultArea');
  area.innerHTML='<div class="loading-box"><div class="spinner"></div><div class="lm">'+(msg||'AI正在解析店铺数据，生成外卖运营方案，请稍候')+'</div><div class="ls">解析时长约30-90秒，无需重复点击</div></div>';
}

/* ---------- 主分析流程 ---------- */
/* ---------- 红线守卫：扫描+重生成+自动移除（用户铁则兜底） ---------- */
var REPORT_RED_LINES=[
  {re:/(8\.?8折|9折|8折|折扣券|会员日)/, label:'老客折扣券/会员折扣（平台不支持）'},
  {re:/(月销\s*[Xx\d]+\s*\+?|月销标签|增加\s*(月销|销量标签))/i, label:'月销/销量标签建议'},
  {re:/(总补贴率|补贴率).{0,8}\d+\s*%|预算.{0,10}(占|分配).{0,6}\d+\s*%/, label:'预算分项比例'},
  {re:/(简化下单|减少下单步骤|缩短下单)/, label:'简化下单步骤'},
