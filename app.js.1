function callReport(api,structured,plan,extra){
  var user={
    platform:structured.shop_base&&structured.shop_base.platform?structured.shop_base.platform:'淘宝闪购',
    structured:structured,
    plan:plan.name,
    extra:extra||'无'
  };
  var msg='请基于以下结构化数据（平台：'+(user.platform)+'），生成本次【'+(user.plan)+'】的完整外卖运营诊断报告。\n分析依据必须是数据本身：文件真实数值、同行对比、扫码用户端前端体验。\n【结构化数据】\n'+JSON.stringify(user.structured,function(k,v){return v==null?null:v;})+'\n【补充说明】'+user.extra;
  return callLLM(api.baseUrl+'/chat/completions',api.apiKey,api.model,
    [{role:'system',content:LLM_SYSTEM + (typeof getStyleSuffix==='function'?getStyleSuffix():'')},{role:'user',content:msg}],api.timeout);
}

/* 菜单优化 JSON（88档） */
function callMenuChanges(api,structured,report){
  var sys='你是资深外卖菜单优化师。基于给定的商品菜单数据和诊断要点，输出菜单优化方案。只输出一个JSON数组，禁止输出其他文字。\n规则：\n1. 只对有明确优化价值的商品做修改，不要强行改所有商品；大部分商品保持原样。\n2. 修改点包括：商品名称（更清晰/更有食欲/加关键词）、描述（补全卖点、分量、辣度、食材）、价格（微调，除非明显不合理否则不改）。\n3. 每个修改项给出 reason（为什么改，一句话）。\n4. 禁止建议下架「不要米饭」「随机蔬菜」这类（若存在）。对含"随机蔬菜"的命名，建议改为具体蔬菜名，理由用正向表述（"换成具体蔬菜更利于下单决策"，不要用"负面联想"）。\n5. 输出JSON数组结构：[{"name":"原商品名","group":"分组","price":原价,"new_name":"新名称(不改则null)","new_desc":"新描述(不改则null)","new_price":新价格(不改则null),"reason":"修改理由"}]';
  var msg='商品菜单数据：\n'+JSON.stringify(structured.products||[])+'\n\n诊断要点（参考）：\n'+(report||'').slice(0,6000);
  return callLLM(api.baseUrl+'/chat/completions',api.apiKey,api.model,
    [{role:'system',content:sys},{role:'user',content:msg}],api.timeout).then(parseJson).then(function(arr){
      if(!Array.isArray(arr)) return [];
      return arr.filter(function(x){return x&&x.name;});
    });
}

/* ---------- 结果渲染 ---------- */
var lastReport={structured:null,report:'',changes:[],plan:null};
function finishAnalysis(structured,report,changes,plan){
  lastReport={structured:structured,report:report,changes:changes,plan:plan};
  // 存档历史
  state.history.unshift({
    t:nowStr(), plan:plan.name, cost:plan.cost,
    shopName:(structured.shop_base&&structured.shop_base.shop_name)||'未命名店铺',
    report:report, changes:changes, structured:structured
  });
  if(state.history.length>10) state.history.length=10;
  saveState();
  renderReport(report,structured,changes,plan);
}
function renderError(err){
  var area=$('resultArea');
  area.innerHTML='<div style="text-align:center;padding:60px 0;color:var(--red);">'+
    '<div style="font-size:16px;font-weight:700;margin-bottom:8px;">分析失败</div>'+
    '<div style="font-size:13px;color:var(--text2);word-break:break-all;">'+String(err&&err.message||err)+'</div>'+
    '<div style="font-size:12px;color:var(--text3);margin-top:12px;">请检查：① API Key 是否正确 ② 接口地址/模型名是否正确 ③ 账户余额是否充足 ④ 网络是否通畅</div></div>';
}
function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function renderReport(report,structured,changes,plan){
  var area=$('resultArea');
  var sb=structured.shop_base||{};
  var flow=structured.flow||{};
  var peer={
    exposure:flow.peer_exposure,
    enter:flow.peer_enter_rate,
    order:flow.peer_order_rate
  };
  function diffStr(cur,peerVal,higherGood){
    if(cur==null||peerVal==null) return '';
    var d=cur-peerVal;
    if(Math.abs(d)<0.0001) return '<span class="m-diff diff-flat">与同行持平</span>';
    var up=d>0;
    var good=higherGood?up:!up;
    if(Math.abs(d)<0.05) return '<span class="m-diff diff-flat">与同行基本持平</span>';
    return '<span class="m-diff '+(good?'diff-up':'diff-down')+'">'+(up?'高于':'低于')+'同行</span>';
  }
  var metricHtml='<div class="metric-grid">'+
    '<div class="metric-card"><div class="m-label">营收（收入）</div><div class="m-val num">'+(sb.income!=null?'¥'+fmt(sb.income):'—（未获取）')+'</div>'+
      '<div class="m-peer">'+(sb.gmv!=null?'营业额 ¥'+fmt(sb.gmv):'')+'</div></div>'+
    '<div class="metric-card"><div class="m-label">订单量</div><div class="m-val num">'+(sb.valid_orders!=null?fmt(sb.valid_orders):'—（未获取）')+'</div>'+
      '<div class="m-peer">有效订单</div></div>'+
    '<div class="metric-card"><div class="m-label">客单价</div><div class="m-val num">¥'+(sb.avg_pay!=null?sb.avg_pay:'—（未获取）')+'</div>'+
      '<div class="m-peer">单均实付</div></div>'+
    '<div class="metric-card"><div class="m-label">曝光量</div><div class="m-val num">'+(flow.exposure!=null?fmt(flow.exposure):'—（未获取）')+'</div>'+
      '<div class="m-peer">同行 '+(peer.exposure!=null?fmt(peer.exposure):'—')+'</div>'+
      (flow.exposure!=null?diffStr(flow.exposure,peer.exposure,true):'')+'</div>'+
    '<div class="metric-card"><div class="m-label">入店转化率</div><div class="m-val num">'+(flow.enter_rate!=null?pct(flow.enter_rate):'—（未获取）')+'</div>'+
      '<div class="m-peer">同行 '+(peer.enter!=null?pct(peer.enter):'—')+'</div>'+
      (flow.enter_rate!=null?diffStr(flow.enter_rate,peer.enter,true):'')+'</div>'+
    '<div class="metric-card"><div class="m-label">下单转化率</div><div class="m-val num">'+(flow.order_rate!=null?pct(flow.order_rate):'—（未获取）')+'</div>'+
      '<div class="m-peer">同行 '+(peer.order!=null?pct(peer.order):'—')+'</div>'+
      (flow.order_rate!=null?diffStr(flow.order_rate,peer.order,true):'')+'</div>'+
    '</div>';
  // 数据来源小字
  var sourceNote='<div style="font-size:11px;color:var(--text3);margin-top:8px;">'+
    '本店流量/转化数据由门店数据文件精确计算；同行对比值来自同行数据截图；客单价=单均实付；营收=门店实收收入。'+\n    '门店基础数据：有效订单 <b>'+fmt(sb.valid_orders)+'</b> 单、营业额 <b>¥'+fmt(sb.gmv)+'</b>、实收 <b>¥'+fmt(sb.income)+'</b>、补贴率 <b>'+pct(sb.subsidy_rate)+'</b></div>';

  var html='';
  html+='<div style="margin-top:20px;font-size:12px;color:var(--text3);">餐谋长·AI运营诊断报告 ｜ 生成时间：'+nowStr()+' ｜ 分析功能：'+plan.name+' ｜ 消耗积分：'+plan.cost+'</div>';
  html+='<div class="sec-block"><div class="sec-title">核心指标概览</div>'+metricHtml+sourceNote+'</div>';
  html+=renderMarkdown(report);
  if(changes&&changes.length){
    html+='<div class="sec-block"><div class="sec-title">优化版菜单（'+changes.length+' 处调整）<button class="btn-mini" onclick="exportMenuXlsx()" style="height:32px;font-size:12px;color:var(--primary);border-color:var(--primary);">导出优化版菜单.xlsx</button></div>';
    html+='<div style="font-size:12px;color:var(--text3);margin-top:8px;">仅列出有明确优化价值的商品，<span class="mark-red">红色</span>标记为本次修改项；其余商品保持原样。</div>';
    html+='<div style="margin-top:10px;overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:12px;"><tr style="background:var(--bg);color:var(--text2);"><th style="padding:8px;text-align:left;border:1px solid var(--border);">商品名称</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">分组</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">原价</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">优化后名称</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">优化后描述</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">新价</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">理由</th></tr>';
    changes.forEach(function(c){
      var changed=c.new_name||c.new_desc||(c.new_price!=null&&c.new_price!==c.price);
      var cell=function(v,isCh){ return '<td style="padding:6px;border:1px solid var(--border);'+(isCh?'color:#C00000;background:#FFE5E5;font-weight:600;':'')+'">'+esc(v==null||v===''?'—':v)+'</td>'; };
      html+='<tr>'+cell(c.name,false)+cell(c.group||'—',false)+cell(c.price!=null?('¥'+c.price):'—',false)+cell(c.new_name||'—',!!c.new_name)+cell(c.new_desc||'—',!!c.new_desc)+cell(c.new_price!=null&&c.new_price!==c.price?('¥'+c.new_price):'—',c.new_price!=null&&c.new_price!==c.price)+cell(c.reason||'—',false)+'</tr>';
    });
    html+='</table></div></div>';
  }
  html+='<div class="disc">免责声明：以上调整建议仅供参考，实际效果受商圈竞品、平台规则等多因素影响，我们会持续盯紧数据及时优化。</div>';
  area.innerHTML=html;
}

/* 简易 Markdown 渲染 */
function renderMarkdown(txt){
  var lines=String(txt||'').split('\n');
  var out=[], inList=null;
  function closeList(){ if(inList){ out.push(inList==='ul'?'</ul>':'</ol>'); inList=null; } }
  lines.forEach(function(raw){
    var line=raw;
    if(/^\s*$/.test(line)){ closeList(); out.push(''); return; }
    var h=line.match(/^#+\s+(.*)/);
    if(h){ closeList(); var n=Math.min(line.match(/^+/)[0].length,3); out.push('<div class="md-h'+n+'">'+inline(line.replace(/^#+\s*/,''))+'</div>'); return; }
    var h2=line.match(/^【(\d+)｜(.*?)】/);
    if(h2){ closeList(); out.push('<div class="md-h2">【'+h2[1]+'｜'+inline(h2[2])+'】</div>'); return; }
    var ul=line.match(/^\s*[-*•]\s+(.*)/);
    if(ul){ if(inList!=='ul'){ closeList(); out.push('<ul>'); inList='ul'; } out.push('<li>'+inline(ul[1])+'</li>'); return; }
    var ol=line.match(/^\s*(\d+)[.、)]\s+(.*)/);
    if(ol){ if(inList!=='ol'){ closeList(); out.push('<ol>'); inList='ol'; } out.push('<li>'+inline(ol[2])+'</li>'); return; }
    closeList(); out.push('<div class="md-body">'+inline(line)+'</div>');
  });
  closeList();
  return out.join('\n');
}
function inline(s){
  s=esc(s);
  s=s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');
  s=s.replace(/\*([^*]+)\*/g,'<i>$1</i>');
  s=s.replace(/`([^`]+)`/g,'<code style="background:var(--bg);padding:1px 4px;border-radius:3px;">$1</code>');
  return s;
}

