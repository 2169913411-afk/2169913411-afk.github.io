          visionModel:(state.api.visionModel||API_DEFAULT.visionModel).trim(),
          timeout:state.api.timeout||180};
}
function parseJson(txt){
  txt=String(txt||'').trim();
  try{ return JSON.parse(txt); }catch(e){}
  var m=txt.match(/```(?:json)?\s*([\s\S]*?)```/); if(m){ try{ return JSON.parse(m[1].trim()); }catch(e2){} }
  var s=txt.indexOf('{'), en=txt.lastIndexOf('}');
  if(s>-1&&en>s){ try{ return JSON.parse(txt.slice(s,en+1)); }catch(e3){} }
  throw new Error('无法解析模型返回的JSON');
}

/* ---------- 上传 ---------- */
function setupZone(zoneId,inputId,handler){
  var zone=$(zoneId), input=$(inputId);
  zone.addEventListener('click',function(){ input.click(); });
  input.addEventListener('change',function(){ handler(input.files); input.value=''; });
  zone.addEventListener('dragover',function(e){ e.preventDefault(); zone.classList.add('drag'); });
  zone.addEventListener('dragleave',function(){ zone.classList.remove('drag'); });
  zone.addEventListener('drop',function(e){
    e.preventDefault(); zone.classList.remove('drag');
    if(e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files.length) handler(e.dataTransfer.files);
  });
}
