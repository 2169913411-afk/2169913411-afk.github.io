function cleanHead(r){ return r.map(function(c){ return String(c==null?'':c).replace(/\s/g,''); }); }

/* 门店数据文件：识别列 + 汇总 */
function parseShopFile(rows){
  // 找表头行：含"有效订单"或"日期"的行
  var headIdx=-1, head=null;
  for(var i=0;i<Math.min(rows.length,10);i++){
    var r=rows[i]||[];
    var h=cleanHead(r);
    if(h.some(function(x){return x==='有效订单'||x==='日期'||x==='收入'||x==='营业额';}) && h.filter(Boolean).length>=8){ headIdx=i; head=h; break; }
  }
  if(headIdx<0) return {ok:false,msg:'未识别到表头（需含 日期/有效订单/收入 等列）'};
  var colMap={};
  SHOP_COLS.forEach(function(need){
    var idx=head.findIndex(function(x){ return x===need || x.indexOf(need)>-1; });
    if(idx>-1) colMap[need]=idx;
  });
  // 汇总每日行（含流量/转化/复购指标聚合）
  var sum={valid_orders:0,gmv:0,income:0,packing_fee:0,subsidy:0,
    exp:0,newExp:0,oldExp:0,enter:0,newEnter:0,oldEnter:0,order:0,newOrder:0,oldOrder:0,
    avgPaySum:0,avgIncSum:0};
  var days=0, daily=[], lastR7=null, lastR30=null;
  function colVal(row,key){ return colMap[key]!=null?num(row[colMap[key]]):0; }
  for(var r=headIdx+1;r<rows.length;r++){
    var row=rows[r]||[];
    if(!row.some(function(c){return c!=null&&String(c).trim()!=='';})) continue;
    var date=colMap['日期']!=null?String(row[colMap['日期']]||''):'';
    var order=colVal(row,'有效订单');
    if(order===0 && !date) continue;
    days++;
    sum.valid_orders+=order;
    sum.income+=colVal(row,'收入');
    sum.gmv+=colVal(row,'营业额')||colVal(row,'商品销售额');
    sum.packing_fee+=colVal(row,'打包费');
    sum.subsidy+=colVal(row,'活动补贴');
    sum.exp+=colVal(row,'曝光人数'); sum.newExp+=colVal(row,'新客曝光人数'); sum.oldExp+=colVal(row,'老客曝光人数');
    sum.enter+=colVal(row,'进店人数'); sum.newEnter+=colVal(row,'新客进店人数'); sum.oldEnter+=colVal(row,'老客进店人数');
    sum.order+=colVal(row,'下单人数'); sum.newOrder+=colVal(row,'新客下单人数'); sum.oldOrder+=colVal(row,'老客下单人数');
    sum.avgPaySum+=colVal(row,'单均实付'); sum.avgIncSum+=colVal(row,'单均收入');
    var r7=colMap['近7日复购率']!=null?row[colMap['近7日复购率']]:null;
    var r30=colMap['近30日复购率']!=null?row[colMap['近30日复购率']]:null;
    if(r7!=null&&String(r7).trim()!=='') lastR7=num(r7);
    if(r30!=null&&String(r30).trim()!=='') lastR30=num(r30);
    daily.push({date:date,orders:order,income:colVal(row,'收入'),gmv:colVal(row,'营业额')||colVal(row,'商品销售额')});
  }
  var avgPay=days?sum.avgPaySum/days:0;
  var subsidyRate=sum.gmv?sum.subsidy/sum.gmv:0;
  var shopName='';
  if(colMap['门店名称']!=null&&rows[headIdx+1]) shopName=String(rows[headIdx+1][colMap['门店名称']]||'');
  // 识别项清单（过滤纯信息列）
  var recognized=Object.keys(colMap).filter(function(k){return k!=='日期'&&k!=='门店名称'&&k!=='门店地址'&&k!=='首次营业时间';});
  var hasFlow=!!colMap['曝光人数'];
  // 流量转化（本店，聚合口径，全部由前端计算）
  var flow=null;
  if(hasFlow){
    flow={
      exposure:sum.exp,
      enter_rate:sum.exp?Math.round((sum.enter/sum.exp)*10000)/10000:null,
      order_rate:sum.enter?Math.round((sum.order/sum.enter)*10000)/10000:null,
      new_customer:{
        exposure:sum.newExp,
        enter_rate:sum.newExp?Math.round((sum.newEnter/sum.newExp)*10000)/10000:null,
        order_rate:sum.newEnter?Math.round((sum.newOrder/sum.newEnter)*10000)/10000:null
      },
      old_customer:{
        exposure:sum.oldExp,
        enter_rate:sum.oldExp?Math.round((sum.oldEnter/sum.oldExp)*10000)/10000:null,
        order_rate:sum.oldEnter?Math.round((sum.oldOrder/sum.oldEnter)*10000)/10000:null
      },
      repurchase_rate:lastR30,
      repurchase_7d:lastR7
    };
  }
  return {
    ok:true,
    colMap:colMap,
    recognizedCount:Object.keys(colMap).length,
    recognized:Object.keys(colMap),
    days:days, shopName:shopName,
    hasFlow:hasFlow, flow:flow,
    shop_base:{
      shop_name:shopName, platform:'淘宝闪购',
      period:days?('近'+days+'天'):'',
      valid_orders:sum.valid_orders, gmv:Math.round(sum.gmv*100)/100,
      income:Math.round(sum.income*100)/100, packing_fee:Math.round(sum.packing_fee*100)/100,
      avg_pay:Math.round(avgPay*100)/100,
      subsidy:Math.round(sum.subsidy*100)/100, subsidy_rate:Math.round(subsidyRate*10000)/10000
    },
    daily:daily
  };
}
function num(v){
  if(v==null||v==='') return 0;
  if(typeof v==='number') return isFinite(v)?v:0;
  var s=String(v).replace(/[%,，\s元]/g,'');
  var n=parseFloat(s); return isNaN(n)?0:n;
}
function handleShopFile(f){
  $('shopName').textContent=f.name; $('shopSize').textContent=fmtSize(f.size);
  $('shopItem').classList.remove('hidden'); $('shopZone').classList.add('hidden');
  $('shopRecog').classList.add('hidden');
  readSheetArray(f).then(function(rows){
    var res=parseShopFile(rows);
    state.shop={file:f,rows:rows,parsed:res};
    if(res.ok){
      var box=$('shopRecog');
      box.className='recog-box';
      var flowLine=res.flow?
        '<div style="margin-top:4px;">流量转化：曝光 <b>'+fmt(res.flow.exposure)+'</b> ｜ 进店率 <b>'+pct(res.flow.enter_rate)+'</b> ｜ 下单率 <b>'+pct(res.flow.order_rate)+'</b> ｜ 新客进店 <b>'+pct(res.flow.new_customer.enter_rate)+'</b> ｜ 老客下单 <b>'+pct(res.flow.old_customer.order_rate)+'</b></div>':'';
      box.innerHTML='<div class="r-title">已识别 '+res.recognizedCount+' 项核心数据</div>'+
        '<div class="recog-list">'+res.recognized.map(function(x){return '<span>'+x+'</span>';}).join('')+'</div>'+
        '<div style="margin-top:4px;">汇总：有效订单 <b>'+fmt(res.shop_base.valid_orders)+'</b> 单 ｜ 营业额 <b>¥'+fmt(res.shop_base.gmv)+'</b> ｜ 收入 <b>¥'+fmt(res.shop_base.income)+'</b> ｜ 单均实付 <b>¥'+fmt(res.shop_base.avg_pay)+'</b> ｜ 补贴率 <b>'+pct(res.shop_base.subsidy_rate)+'</b></div>'+
        flowLine;
      box.classList.remove('hidden');
    }else{
      var box2=$('shopRecog'); box2.className='recog-box err';
      box2.innerHTML='<div class="r-title">⚠️ 识别异常</div>'+res.msg;
      box2.classList.remove('hidden');
    }
    RECOGNIZED.shop=res;
    updateStartBtn();
  });
}
function removeShop(){ state.shop=null; RECOGNIZED.shop=null; $('shopItem').classList.add('hidden'); $('shopZone').classList.remove('hidden'); $('shopRecog').classList.add('hidden'); updateStartBtn(); }

/* 菜单数据文件：识别 商品名称/菜单分组/价格/描述 */
function parseMenuFile(rows){
  var headIdx=-1, head=null;
  for(var i=0;i<Math.min(rows.length,8);i++){
    var h=cleanHead(rows[i]||[]);
    if(h.some(function(x){return x.indexOf('商品名称')>-1||x.indexOf('菜名')>-1||x.indexOf('名称')>-1||x.indexOf('品名')>-1;})){ headIdx=i; head=h; break; }
  }
  if(headIdx<0) return {ok:false,msg:'未识别到商品名称表头'};
  function findCol(keys){
    for(var i=0;i<head.length;i++){ for(var j=0;j<keys.length;j++){ if(head[i]&&head[i].indexOf(keys[j])>-1) return i; } }
    return -1;
  }
  var idxName=findCol(['商品名称','菜名','品名','名称']);
  var idxGroup=findCol(['菜单分组','分组','分类','类目']);
  var idxPrice=findCol(['现价','价格','售价','单价']);
  var idxSales=findCol(['月售','销量','售出']);
  var idxDesc=findCol(['描述','说明','介绍','卖点']);
  if(idxName<0) return {ok:false,msg:'未找到商品名称列'};
  var products=[];
  for(var r=headIdx+1;r<rows.length;r++){
    var row=rows[r]||[];
    if(!row.some(function(c){return c!=null&&String(c).trim()!=='';})) continue;
    var name=String(row[idxName]==null?'':row[idxName]).trim();
    if(!name||name.indexOf('说明')>-1) continue;
    var g=idxGroup>-1?(row[idxGroup]==null?'':String(row[idxGroup]).trim()):'';
    var p=idxPrice>-1?num(row[idxPrice]):0;
    var d=idxDesc>-1?(row[idxDesc]==null?'':String(row[idxDesc]).trim()):'';
    var sRaw=idxSales>-1?(row[idxSales]==null?'':String(row[idxSales]).trim()):'';
    var sNum=0;
    if(sRaw){ var sm=sRaw.match(/(\d+(?:\.\d+)?)/); if(sm) sNum=parseFloat(sm[1]); }
    if(g==='/') g='';
    products.push({name:name,group:g,price:p,desc:d,salesRaw:sRaw,sales:sNum});
    if(products.length>=500) break;
  }
  var found=[];
  if(idxName>-1) found.push('商品名称');
  if(idxGroup>-1) found.push('菜单分组');
  if(idxPrice>-1) found.push('价格');
  if(idxSales>-1) found.push('月售');
  if(idxDesc>-1) found.push('描述');
  return {ok:true,found:found,products:products,groupCount:new Set(products.map(function(x){return x.group||'未分组';})).size};
}
function handleMenuFile(f){
  $('menuName').textContent=f.name; $('menuSize').textContent=fmtSize(f.size);
  $('menuItem').classList.remove('hidden'); $('menuZone').classList.add('hidden');
  $('menuRecog').classList.add('hidden');
  readSheetArray(f).then(function(rows){
    var res=parseMenuFile(rows);
    state.menu={file:f,rows:rows,parsed:res};
    var box=$('menuRecog');
    if(res.ok){
      var missing=[]; ['商品名称','菜单分组','价格','描述'].forEach(function(x){ if(res.found.indexOf(x)<0) missing.push(x); });
      box.className='recog-box';
      box.innerHTML='<div class="r-title">已识别 '+res.found.join('、')+'，共 '+res.products.length+' 个商品</div>'+
        '<div class="recog-list">'+res.found.map(function(x){return '<span>'+x+'</span>';}).join('')+'</div>'+
        (missing.length?'<div style="color:#B45309;margin-top:4px;">未识别列：'+missing.join('、')+'</div>':'')+
        '<div style="margin-top:2px;">分组数：'+res.groupCount+'</div>';
    }else{
      box.className='recog-box err';
      box.innerHTML='<div class="r-title">⚠️ 识别异常</div>'+res.msg;
    }
    box.classList.remove('hidden');
    RECOGNIZED.menu=res;
    updateStartBtn();
  });
}
