/* ---------- AI 调用（OpenAI 兼容 / 智谱） ---------- */
function callLLM(url,key,model,messages,timeout,maxTokens){
  var controller=(typeof AbortController!=='undefined')?new AbortController():null;
  var timer=controller?setTimeout(function(){controller.abort();},(timeout||180)*1000):null;
  var opt={method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
    body:JSON.stringify({model:model,messages:messages,temperature:0.3,max_tokens:maxTokens||12000})};
  if(controller) opt.signal=controller.signal;
  return fetch(url,opt).then(function(res){
    if(timer) clearTimeout(timer);
    if(!res.ok) return res.text().then(function(t){ throw new Error('HTTP '+res.status+' '+String(t).slice(0,200)); });
    return res.json();
  }).then(function(data){
    var c=data&&data.choices&&data.choices[0]&&data.choices[0].message&&data.choices[0].message.content;
    if(!c) throw new Error('模型返回为空');
    return c;
  });
}
function getApi(){
  return {baseUrl:(state.api.baseUrl||API_DEFAULT.baseUrl).trim().replace(/\/+$/,''),
