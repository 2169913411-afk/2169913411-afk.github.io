/* 通用二维码识别（图片 → 文本内容） */
function recognizeQrFromDataUrl(dataUrl, onResult){
  var img=new Image();
  img.onload=function(){
    try{
      var c=document.createElement('canvas'); c.width=img.width; c.height=img.height;
      var ctx=c.getContext('2d'); ctx.drawImage(img,0,0);
      var id=ctx.getImageData(0,0,c.width,c.height);
      var code=null;
      try{ if(window.jsQR) code=jsQR(id.data,id.width,id.height); }catch(e){}
      if(onResult) onResult(code?String(code.data).trim():'');
    }catch(e){ if(onResult) onResult(''); }
  };
  img.onerror=function(){ if(onResult) onResult(''); };
  img.src=dataUrl;
}
function handlePastedImage(f,target){
  if(target==='qr2'){
    fileToDataUrl(f,0).then(function(d){
      recognizeQrFromDataUrl(d,function(txt){
        if(txt){
          var isUrl=/^https?:\/\//i.test(txt);
          if($('qrResult')) $('qrResult').innerHTML='<span style="color:#16A34A;">✅ 已识别'+(isUrl?'链接':'内容')+'：'+esc(txt.slice(0,60))+'</span>';
          window.__scrapeQR=txt;
          if(isUrl&&$('shopLink')) $('shopLink').value=txt;
          toast('已粘贴二维码并识别'+(isUrl?'链接':'内容'));
        }else{
          if($('qrResult')) $('qrResult').innerHTML='<span style="color:#B45309;">⚠️ 二维码未能自动识别，可改为粘贴链接</span>';
          window.__scrapeQR='';
          toast('二维码未能识别，请改为粘贴链接');
        }
      });
    });
    return;
  }
  if(target==='peer'){
    if(state.peer.length>=8){ toast('最多8张截图，请先删除部分再粘贴'); return; }
    fileToDataUrl(f,0).then(function(d){
      state.peer.push({file:f,dataUrl:d,name:f.name||('粘贴截图_'+Date.now()+'.png')});
      renderPeerThumbs();
      toast('已粘贴到「同行数据以及重要截图」');
    });
    return;
  }
  if(!state.qr){
    fileToDataUrl(f,0).then(function(d){
      state.qr={file:f,dataUrl:d,name:f.name||('粘贴图片_'+Date.now()+'.png')};
      if($('qrName')) $('qrName').textContent=state.qr.name;
      if($('qrItem')) $('qrItem').classList.remove('hidden');
      if($('qrZone')) $('qrZone').classList.add('hidden');
      updateStartBtn();
      toast('已粘贴为门店二维码');
    });
  } else {
    if(state.peer.length>=8){ toast('最多8张截图，请先删除部分再粘贴'); return; }
    fileToDataUrl(f,0).then(function(d){
      state.peer.push({file:f,dataUrl:d,name:f.name||('粘贴截图_'+Date.now()+'.png')});
      renderPeerThumbs();
      toast('已粘贴为同行/重要截图');
    });
  }
}
document.addEventListener('paste',function(e){
  var items=(e.clipboardData&&e.clipboardData.items)||[];
  for(var i=0;i<items.length;i++){
    if(items[i].type&&items[i].type.indexOf('image')===0){
      var f=items[i].getAsFile();
      if(!f) continue;
      e.preventDefault();
      handlePastedImage(f, pasteTarget);
      return;
    }
  }
});

/* 3/4/5 文件解析（SheetJS 优先 + 原生兜底） */
function readSheetArray(file){
  return new Promise(function(resolve){
    file.arrayBuffer().then(function(buf){
      if(typeof XLSX!=='undefined'&&XLSX.read){
        try{
          var wb=XLSX.read(new Uint8Array(buf),{type:'array'});
          var first=wb.SheetNames[0];
          var rows=XLSX.utils.sheet_to_json(wb.Sheets[first],{header:1,defval:null});
          return resolve(rows);
        }catch(e){}
      }
      return readXlsxManual(buf).then(resolve);
    })['catch'](function(){ resolve([]); });
  });
}
function readXlsxManual(buf){
  return Promise.resolve().then(function(){
    return unzipText(buf,'xl/sharedStrings.xml').then(function(sharedXml){
      return unzipText(buf,'xl/worksheets/sheet1.xml').then(function(sheetXml){
        if(!sheetXml) return [];
        var shared=[];
        if(sharedXml){
          var siRe=/<si[\s\S]*?<\/si>/g, tRe=/<t[^>]*>([\s\S]*?)<\/t>/g, m;
          while((m=siRe.exec(sharedXml))){
            var txt='',tm; tRe.lastIndex=0;
            while((tm=tRe.exec(m[0]))) txt+=xmlDecode(tm[1]);
            shared.push(txt);
          }
        }
        var rows=[], rowRe=/<row[^>]*r="(\d+)"[^>]*>([\s\S]*?)<\/row>/g, rm;
        var cellRe=/<c[^>]*r="([A-Z]+)(\d+)"([^>]*)>([\s\S]*?)<\/c>/g;
        var maxCol=0;
        while((rm=rowRe.exec(sheetXml))){
          var cells=[], cm; cellRe.lastIndex=0;
          while((cm=cellRe.exec(rm[2]))){
            var col=cm[1], rowN=parseInt(cm[2],10);
            var ci=0; for(var k=0;k<col.length;k++) ci=ci*26+(col.charCodeAt(k)-64); ci--;
            if(ci+1>maxCol) maxCol=ci+1;
            var attrs=cm[3]||'', val='';
            var vm=/<v>([\s\S]*?)<\/v>/.exec(cm[4]);
            var im=/<is>[\s\S]*?<t[^>]*>([\s\S]*?)<\/t>[\s\S]*?<\/is>/.exec(cm[4]);
            if(im) val=xmlDecode(im[1]);
            else if(vm){
              if(attrs.indexOf('t="s"')>-1||attrs.indexOf("t='s'")>-1) val=shared[parseInt(vm[1],10)]||'';
              else val=vm[1];
            }
            cells[ci]=val;
          }
          for(var j=0;j<maxCol;j++) if(cells[j]===undefined) cells[j]=null;
          rows.push(cells);
        }
        return rows;
      });
    });
  });
}
function inflateRaw(uint8){
  if(typeof DecompressionStream==='undefined') return Promise.resolve(null);
  var ds=new DecompressionStream('deflate-raw');
  return new Response(new Blob([uint8]).stream().pipeThrough(ds)).arrayBuffer();
}
function findZipEntry(buf,target){
  var dv=new DataView(buf),pos=0;
  while(pos+30<=buf.byteLength){
    if(dv.getUint32(pos,true)!==0x04034b50){pos++;continue;}
    var method=dv.getUint16(pos+8,true), comp=dv.getUint32(pos+18,true);
    var nl=dv.getUint16(pos+26,true), el=dv.getUint16(pos+28,true);
    var name=new TextDecoder().decode(new Uint8Array(buf,pos+30,nl));
    var start=pos+30+nl+el;
    var data=new Uint8Array(buf.slice(start,start+comp));
    if(name===target) return {method:method,data:data};
    pos=start+comp;
  }
  return null;
}
function unzipText(buf,name){
  var e=findZipEntry(buf,name);
  if(!e) return Promise.resolve(null);
  if(e.method===0) return Promise.resolve(new TextDecoder().decode(e.data));
  return inflateRaw(e.data).then(function(ab){ return ab?new TextDecoder().decode(ab):null; });
}
function xmlDecode(s){ return String(s).replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&nbsp;/g,' '); }

/* ---------- 数据识别 ---------- */
var RECOGNIZED={shop:null,menu:null,review:null};

function cleanHead(r){ return r.map(function(c){ return String(c==null?'':c).replace(/\s/g,''); }); }

/* 门店数据文件：识别列 + 汇总 */
function parseShopFile(rows){
  var headIdx=-1, head=null;
  for(var i=0;i<Math.min(rows.length,10);i++){
    var r=rows[i]||[];
    var h=cleanHead(r);
    if(h.some(function(x){return x==='有效订单'||x==='日期'||x==='收入'||x==='营业额';}) && h.filter(Boolean).length>=8){ headIdx=i; head=h; break; }
  }
  if(headIdx<0) return {ok:false,msg:'未识别到表头（需含 日期/有效订单/收入 等列）'};
  var colMap={};
  SHOP_COLS.forEach(function(need){
    var idx=head.findIndex(function(x){ return x===need || x.indexOf(need)>-1; });
    if(idx>-1) colMap[need]=idx;
  });
  var sum={valid_orders:0,gmv:0,income:0,packing_fee:0,subsidy:0,bad_orders:0,
    exp:0,newExp:0,oldExp:0,enter:0,newEnter:0,oldEnter:0,order:0,newOrder:0,oldOrder:0,
    avgPaySum:0,avgIncSum:0};
  var days=0, daily=[], lastR7=null, lastR30=null;
  function colVal(row,key){ return colMap[key]!=null?num(row[colMap[key]]):0; }
  for(var r=headIdx+1;r<rows.length;r++){
    var row=rows[r]||[];
    if(!row.some(function(c){return c!=null&&String(c).trim()!=='';})) continue;
    var date=colMap['日期']!=null?String(row[colMap['日期']]||''):'';
    var order=colVal(row,'有效订单');
    if(order===0 && !date) continue;
    days++;
    sum.valid_orders+=order;
    sum.income+=colVal(row,'收入');
    sum.gmv+=colVal(row,'营业额')||colVal(row,'商品销售额');
    sum.packing_fee+=colVal(row,'打包费');
    sum.subsidy+=colVal(row,'活动补贴');
    sum.bad_orders+=colVal(row,'差评订单数');
    sum.exp+=colVal(row,'曝光人数'); sum.newExp+=colVal(row,'新客曝光人数'); sum.oldExp+=colVal(row,'老客曝光人数');
    sum.enter+=colVal(row,'进店人数'); sum.newEnter+=colVal(row,'新客进店人数'); sum.oldEnter+=colVal(row,'老客进店人数');
    sum.order+=colVal(row,'下单人数'); sum.newOrder+=colVal(row,'新客下单人数'); sum.oldOrder+=colVal(row,'老客下单人数');
    sum.avgPaySum+=colVal(row,'单均实付'); sum.avgIncSum+=colVal(row,'单均收入');
    var r7=colMap['近7日复购率']!=null?row[colMap['近7日复购率']]:null;
    var r30=colMap['近30日复购率']!=null?row[colMap['近30日复购率']]:null;
    if(r7!=null&&String(r7).trim()!=='') lastR7=num(r7);
    if(r30!=null&&String(r30).trim()!=='') lastR30=num(r30);
    daily.push({date:date,orders:order,income:colVal(row,'收入'),gmv:colVal(row,'营业额')||colVal(row,'商品销售额')});
  }
  var avgPay=days?sum.avgPaySum/days:0;
  var subsidyRate=sum.gmv?sum.subsidy/sum.gmv:0;
  var shopName='';
  if(colMap['门店名称']!=null&&rows[headIdx+1]) shopName=String(rows[headIdx+1][colMap['门店名称']]||'');
  var recognized=Object.keys(colMap).filter(function(k){return k!=='日期'&&k!=='门店名称'&&k!=='门店地址'&&k!=='首次营业时间';});
  var hasFlow=!!colMap['曝光人数'];
  var flow=null;
  if(hasFlow){
    flow={
      exposure:sum.exp,
      enter_rate:sum.exp?Math.round((sum.enter/sum.exp)*10000)/10000:null,
      order_rate:sum.enter?Math.round((sum.order/sum.enter)*10000)/10000:null,
      new_customer:{
        exposure:sum.newExp,
        enter_rate:sum.newExp?Math.round((sum.newEnter/sum.newExp)*10000)/10000:null,
        order_rate:sum.newEnter?Math.round((sum.newOrder/sum.newEnter)*10000)/10000:null
      },
      old_customer:{
        exposure:sum.oldExp,
        enter_rate:sum.oldExp?Math.round((sum.oldEnter/sum.oldExp)*10000)/10000:null,
        order_rate:sum.oldEnter?Math.round((sum.oldOrder/sum.oldEnter)*10000)/10000:null
      },
      repurchase_rate:lastR30,
      repurchase_7d:lastR7
    };
  }
  return {
    ok:true,
    colMap:colMap,
    recognizedCount:Object.keys(colMap).length,
    recognized:Object.keys(colMap),
    days:days, shopName:shopName,
    hasFlow:hasFlow, flow:flow,
    shop_base:{
      shop_name:shopName, platform:'淘宝闪购',
      period:days?('近'+days+'天'):'',
      valid_orders:sum.valid_orders, gmv:Math.round(sum.gmv*100)/100,
      income:Math.round(sum.income*100)/100, packing_fee:Math.round(sum.packing_fee*100)/100,
      avg_pay:Math.round(avgPay*100)/100,
      subsidy:Math.round(sum.subsidy*100)/100, subsidy_rate:Math.round(subsidyRate*10000)/10000,
      bad_orders:sum.bad_orders
    },
    daily:daily
  };
}
function num(v){
  if(v==null||v==='') return 0;
  if(typeof v==='number') return isFinite(v)?v:0;
  var s=String(v).replace(/[%,，\s元]/g,'');
  var n=parseFloat(s); return isNaN(n)?0:n;
}
