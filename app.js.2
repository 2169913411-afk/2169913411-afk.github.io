/* ---------- 主分析流程 ---------- */
/* ---------- 红线守卫：扫描+重生成+自动移除（用户铁则兜底） ---------- */
var REPORT_RED_LINES=[
  {re:/(8\.?8折|9折|8折|折扣券|会员日)/, label:'老客折扣券/会员折扣（平台不支持）'},
  {re:/(月销\s*[Xx\d]+\s*\+?|月销标签|增加\s*(月销|销量标签))/i, label:'月销/销量标签建议'},
  {re:/(总补贴率|补贴率).{0,8}\d+\s*%|预算.{0,10}(占|分配).{0,6}\d+\s*%/, label:'预算分项比例'},
  {re:/(简化下单|减少下单步骤|缩短下单)/, label:'简化下单步骤'},
  {re:/(积分兑换|会员积分体系)/, label:'会员积分体系'}
];
function findViolations(text){
  var v=[];
  REPORT_RED_LINES.forEach(function(it){ if(it.re.test(text||'')) v.push(it.label); });
  return v;
}
function redactReport(text){
  var lines=String(text||'').split('\n');
  var kept=[], removed=[];
  lines.forEach(function(ln){
    if(/^#|【/.test(ln)){ kept.push(ln); return; }
    var drop=false, why='';
    REPORT_RED_LINES.forEach(function(it){
      if(!drop&&it.re.test(ln)&&/(建议|推荐|优惠|活动|标签|设置|增加|建立|发放|享|控制|倾斜|补贴)/.test(ln)){
        drop=true; why=it.label;
      }
    });
    if(drop){ if(removed.indexOf(why)<0) removed.push(why); }
    else kept.push(ln);
  });
  return {text:kept.join('\n').replace(/\n{3,}/g,'\n\n'),removed:removed};
}
function guardReport(api,structured,plan,extra,attempt){
  return callReport(api,structured,plan,extra).then(function(report){
    var v=findViolations(report);
    if(v.length&&attempt<2){
      var fb='\n\n【重要·必须遵守】上次输出包含以下被系统禁止的内容，请严格删除这些内容及相关同类表述后重新完整输出，不要解释、不要保留任何变体：'+v.join('、');
      return guardReport(api,structured,plan,extra+fb,attempt+1);
    }
    var rd=redactReport(report);
    if(rd.removed.length){
      toast('已自动移除平台不支持的 '+rd.removed.length+' 类建议（'+rd.removed.join('、')+'）');
    }
    return rd.text;
  });
}
/* 菜单变更守卫：只保留真实存在的商品、有效价格、非下架米饭；改动数量≤30% */
function filterMenuChanges(changes,products){
  var names={};
  (products||[]).forEach(function(p){ names[p.name]=true; });
  var bad=[];
  var out=(changes||[]).filter(function(c){
    if(!c||!c.name) return false;
    if(!names[c.name]){ bad.push(c.name); return false; }        // 不存在商品
    if(!c.new_name&&!c.new_desc&&c.new_price==null) return false; // 无实际改动
    if(c.new_price!=null&&(c.new_price<=0||c.new_price<3)){ bad.push(c.name); return false; }
    if(c.new_name&&c.new_name.indexOf('不要米饭')>-1) return false;
    var isRice=(c.name.indexOf('不要米饭')>-1)||(c.new_name&&c.new_name.indexOf('不要米饭')>-1);
    if(isRice&&/下架|删除/.test(c.reason||'')){ bad.push(c.name); return false; } // 下架不要米饭
    return true;
  });
  var cap=Math.max(1,Math.ceil(((products||[]).length||1)*0.3));
  if(out.length>cap){ bad.push('（改动过多，已截断至 '+cap+' 项）'); out=out.slice(0,cap); }
  if(bad.length) toast('菜单优化已过滤 '+bad.length+' 项无效改动：'+bad.slice(0,5).join('、'));
  return out;
}
function runAnalysis(plan){
  var structured=buildStructured();
  var api=getApi();
  var images=[];
  var tasks=[];
  if(state.qr&&state.qr.dataUrl) images.push({type:'qr',data:state.qr.dataUrl});
  state.peer.forEach(function(s){ images.push({type:'peer',data:s.dataUrl}); });

  // Pass 1: 视觉提取（同行对比值 + 前端体验）
  var peerP=Promise.resolve(null), qrP=Promise.resolve(null);
  var peerImgs=images.filter(function(i){return i.type==='peer';});
  if(peerImgs.length){
    peerP=callPeerExtract(api,peerImgs).then(function(v){
      if(v&&v.peer){
        // 视觉返回的转化率为百分数(如7.8)，统一转小数(0.078)与门店文件口径一致
        var toF=function(x){ return (x==null||isNaN(x))?null:(x/100); };
        structured.peer={exposure:v.peer.exposure,enter_rate:toF(v.peer.enter_rate),order_rate:toF(v.peer.order_rate),
          new_customer_enter:toF(v.peer.new_customer_enter),new_customer_order:toF(v.peer.new_customer_order),
          old_customer_enter:toF(v.peer.old_customer_enter),old_customer_order:toF(v.peer.old_customer_order)};
        if(structured.flow){
          structured.flow.peer_exposure=v.peer.exposure!=null?v.peer.exposure:structured.flow.peer_exposure;
          structured.flow.peer_enter_rate=v.peer.enter_rate!=null?toF(v.peer.enter_rate):structured.flow.peer_enter_rate;
          structured.flow.peer_order_rate=v.peer.order_rate!=null?toF(v.peer.order_rate):structured.flow.peer_order_rate;
          if(structured.flow.new_customer){
            structured.flow.new_customer.peer_enter_rate=v.peer.new_customer_enter!=null?toF(v.peer.new_customer_enter):null;
            structured.flow.new_customer.peer_order_rate=v.peer.new_customer_order!=null?toF(v.peer.new_customer_order):null;
          }
          if(structured.flow.old_customer){
            structured.flow.old_customer.peer_enter_rate=v.peer.old_customer_enter!=null?toF(v.peer.old_customer_enter):null;
            structured.flow.old_customer.peer_order_rate=v.peer.old_customer_order!=null?toF(v.peer.old_customer_order):null;
          }
        } else {
          structured.flow={peer_exposure:v.peer.exposure,peer_enter_rate:toF(v.peer.enter_rate),peer_order_rate:toF(v.peer.order_rate)};
        }
      }
      return v;
    })['catch'](function(err){
      toast('同行对比数据识别失败（'+err.message+'），将跳过该部分');
      return null;
    });
  }
  if(state.qr&&state.qr.dataUrl){
    qrP=callQrObserve(api,state.qr.dataUrl).then(function(v){
      if(v&&v.frontend) structured.frontend_experience=Object.assign(structured.frontend_experience||{},v.frontend);
      return v;
    })['catch'](function(){ return null; });
  }
  Promise.all([peerP,qrP]).then(function(){
    return guardReport(api,structured,plan,state.notesText(),0);
  }).then(function(report){
    if(plan.cost>=88){
      return callMenuChanges(api,structured,report).then(function(changes){
        finishAnalysis(structured,report,filterMenuChanges(changes,structured.products||[]),plan);
      })['catch'](function(e){
        toast('菜单优化生成失败：'+e.message);
        finishAnalysis(structured,report,[],plan);
      });
    }
    finishAnalysis(structured,report,[],plan);
  })['catch'](function(err){
    renderError(err);
  });
}
state.notesText=function(){ return $('notesInput').value.trim(); };

/* 视觉提取 prompt（只提取同行对比值 + 前端体验；本店指标已由门店文件精确计算） */
function callPeerExtract(api,peerImages){
  var sys='你是外卖运营数据录入助手。用户上传了【同行数据对比截图】。任务：从同行对比截图中提取【同行（商圈均值）】数值。\n要求：\n1. 只输出一个JSON对象，禁止输出其他文字。\n2. 先识别这张截图的顾客维度（全部顾客/新客/老客，看截图中的维度选中项），提取该维度下【同行/商圈均值】的真实数值并按维度归位：\n   - 全部顾客截图 → exposure(同行曝光人数)、enter_rate(同行入店转化率)、order_rate(同行下单转化率)\n   - 新客截图 → new_customer_enter(同行新客进店转化率)、new_customer_order(同行新客下单转化率)\n   - 老客截图 → old_customer_enter(同行老客进店转化率)、old_customer_order(同行老客下单转化率)\n   数值必须是截图中的真实数值（同行/商圈均值那一列），看不清或没有就填 null，绝对禁止编造。不要提取本店数值（本店数值由系统文件精确计算，不需要你提供）。\n输出JSON：{"peer":{"exposure":number|null,"enter_rate":number|null,"order_rate":number|null,"new_customer_enter":number|null,"new_customer_order":number|null,"old_customer_enter":number|null,"old_customer_order":number|null}}';
  var keys=['exposure','enter_rate','order_rate','new_customer_enter','new_customer_order','old_customer_enter','old_customer_order'];
  var merged={};
  // 逐张识别（每次只传1张图，规避视觉模型单次图片数量上限1210），小并发池加速，结果合并取并集
  var imgs=(peerImages||[]).slice();
  function work(img){
    var parts=[{type:'text',text:'请识别这一张同行对比截图中的同行（商圈均值）数值，按顾客维度归位。'}];
    parts.push({type:'image_url',image_url:{url:img.data}});
    return callLLM(api.baseUrl+'/chat/completions',api.apiKey,api.visionModel||API_DEFAULT.visionModel,
      [{role:'system',content:sys},{role:'user',content:parts}],api.timeout,1024)
    .then(parseJson)['catch'](function(){ return null; })
    .then(function(v){
      if(v&&v.peer){
        keys.forEach(function(k){ if(v.peer[k]!=null&&merged[k]==null) merged[k]=v.peer[k]; });
      }
      return null;
    });
  }
  function pump(){
    if(!imgs.length) return Promise.resolve();
    var batch=[];
    while(imgs.length&&batch.length<3){ batch.push(imgs.shift()); }
    return Promise.all(batch.map(work)).then(pump);
  }
  return pump().then(function(){ return merged&&keys.some(function(k){return merged[k]!=null;})?{peer:merged}:null; });
}
function callQrObserve(api,qrDataUrl){
  var sys='你是外卖运营专家。用户提供了门店二维码/店铺首页截图。请模拟顾客扫码进店，做用户视角前端体验观察，输出简洁要点，不编造截图里没有的东西。\n要求：只输出一个JSON：{"frontend":{"notes":"一句话总结","dims":{"装修风格":"...","主图质量":"...","商品排序":"...","价格活动展示":"...","销量标签":"...","菜品信息":"...","下单路径":"..."}}}';
  var parts=[{type:'text',text:'请观察这张门店二维码/首页截图，做前端体验观察。'},{type:'image_url',image_url:{url:qrDataUrl}}];
  return callLLM(api.baseUrl+'/chat/completions',api.apiKey,api.visionModel||API_DEFAULT.visionModel,
    [{role:'system',content:sys},{role:'user',content:parts}],api.timeout,1024).then(parseJson);
}

