function callReport(api,structured,plan,extra){
  var user={
    platform:structured.shop_base&&structured.shop_base.platform?structured.shop_base.platform:'淘宝闪购',
    structured:structured,
    plan:plan.name,
    extra:extra||'无'
  };
  var msg='请基于以下结构化数据（平台：'+(user.platform)+'），生成本次【'+(user.plan)+'】的完整外卖运营诊断报告。\n分析依据必须是数据本身：文件真实数值、同行对比、扫码用户端前端体验。\n【结构化数据】\n'+JSON.stringify(user.structured,function(k,v){return v==null?null:v;})+'\n【补充说明】'+user.extra;
  return callLLM(api.baseUrl+'/chat/completions',api.apiKey,api.model,
    [{role:'system',content:LLM_SYSTEM},{role:'user',content:msg}],api.timeout);
}

/* 菜单优化 JSON（88档） */
function callMenuChanges(api,structured,report){
  var sys='你是资深外卖菜单优化师。基于给定的商品菜单数据和诊断要点，输出菜单优化方案。只输出一个JSON数组，禁止输出其他文字。\n规则：\n1. 只对有明确优化价值的商品做修改，不要强行改所有商品；大部分商品保持原样。\n2. 修改点包括：商品名称（更清晰/更有食欲/加关键词）、描述（补全卖点、分量、辣度、食材）、价格（微调，除非明显不合理否则不改）。\n3. 每个修改项给出 reason（为什么改，一句话）。\n4. 禁止建议下架「不要米饭」「随机蔬菜」这类（若存在）。对含“随机蔬菜”的命名，建议改为具体蔬菜名，理由用正向表述（“换成具体蔬菜更利于下单决策”，不要用“负面联想”）。\n5. 输出JSON数组结构：[{"name":"原商品名","group":"分组","price":原价,"new_name":"新名称(不改则null)","new_desc":"新描述(不改则null)","new_price":新价格(不改则null),"reason":"修改理由"}]';
  var msg='商品菜单数据：\n'+JSON.stringify(structured.products||[])+'\n\n诊断要点（参考）：\n'+(report||'').slice(0,6000);
  return callLLM(api.baseUrl+'/chat/completions',api.apiKey,api.model,
    [{role:'system',content:sys},{role:'user',content:msg}],api.timeout).then(parseJson).then(function(arr){
      if(!Array.isArray(arr)) return [];
      return arr.filter(function(x){return x&&x.name;});
    });
}

