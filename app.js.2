      html+='<tr>'+cell(c.name,false)+cell(c.group||'—',false)+cell(c.price!=null?('¥'+c.price):'—',false)+cell(c.new_name||'—',!!c.new_name)+cell(c.new_desc||'—',!!c.new_desc)+cell(c.new_price!=null&&c.new_price!==c.price?('¥'+c.new_price):'—',c.new_price!=null&&c.new_price!==c.price)+cell(c.reason||'—',false)+'</tr>';
    });
    html+='</table></div></div>';
  }
  html+='<div class="disc">免责声明：以上调整建议仅供参考，实际效果受商圈竞品、平台规则等多因素影响，我们会持续盯紧数据及时优化。</div>';
  area.innerHTML=html;
}

/* 简易 Markdown 渲染 */
function renderMarkdown(txt){
  var lines=String(txt||'').split('\n');
  var out=[], inList=null;
  function closeList(){ if(inList){ out.push(inList==='ul'?'</ul>':'</ol>'); inList=null; } }
  lines.forEach(function(raw){
    var line=raw;
    if(/^\s*$/.test(line)){ closeList(); out.push(''); return; }
    var h=line.match(/^#+\s+(.*)/);
    if(h){ closeList(); var n=Math.min(line.match(/^#+/)[0].length,3); out.push('<div class="md-h'+n+'">'+inline(line.replace(/^#+\s*/,''))+'</div>'); return; }
    var h2=line.match(/^【(\d+)｜(.*?)】/);
    if(h2){ closeList(); out.push('<div class="md-h2">【'+h2[1]+'｜'+inline(h2[2])+'】</div>'); return; }
    var ul=line.match(/^\s*[-*•]\s+(.*)/);
    if(ul){ if(inList!=='ul'){ closeList(); out.push('<ul>'); inList='ul'; } out.push('<li>'+inline(ul[1])+'</li>'); return; }
    var ol=line.match(/^\s*(\d+)[.、)]\s+(.*)/);
    if(ol){ if(inList!=='ol'){ closeList(); out.push('<ol>'); inList='ol'; } out.push('<li>'+inline(ol[2])+'</li>'); return; }
    closeList(); out.push('<div class="md-body">'+inline(line)+'</div>');
  });
  closeList();
  return out.join('\n');
}
function inline(s){
  s=esc(s);
  s=s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');
  s=s.replace(/\*([^*]+)\*/g,'<i>$1</i>');
  s=s.replace(/`([^`]+)`/g,'<code style="background:var(--bg);padding:1px 4px;border-radius:3px;">$1</code>');
  return s;
}

