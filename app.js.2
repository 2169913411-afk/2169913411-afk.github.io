function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function renderReport(report,structured,changes,plan){
  var area=$('resultArea');
  var sb=structured.shop_base||{};
  var flow=structured.flow||{};
  var peer={
    exposure:flow.peer_exposure,
    enter:flow.peer_enter_rate,
    order:flow.peer_order_rate
  };
  function diffStr(cur,peerVal,higherGood){
    if(cur==null||peerVal==null) return '';
    var d=cur-peerVal;
    if(Math.abs(d)<0.0001) return '<span class="m-diff diff-flat">与同行持平</span>';
    var up=d>0;
    var good=higherGood?up:!up;
    if(Math.abs(d)<0.05) return '<span class="m-diff diff-flat">与同行基本持平</span>';
    return '<span class="m-diff '+(good?'diff-up':'diff-down')+'">'+(up?'高于':'低于')+'同行</span>';
  }
  var metricHtml='<div class="metric-grid">'+
    '<div class="metric-card"><div class="m-label">营收（收入）</div><div class="m-val num">'+(sb.income!=null?'¥'+fmt(sb.income):'—（未获取）')+'</div>'+
      '<div class="m-peer">'+(sb.gmv!=null?'营业额 ¥'+fmt(sb.gmv):'')+'</div></div>'+
    '<div class="metric-card"><div class="m-label">订单量</div><div class="m-val num">'+(sb.valid_orders!=null?fmt(sb.valid_orders):'—（未获取）')+'</div>'+
      '<div class="m-peer">有效订单</div></div>'+
    '<div class="metric-card"><div class="m-label">客单价</div><div class="m-val num">¥'+(sb.avg_pay!=null?sb.avg_pay:'—（未获取）')+'</div>'+
      '<div class="m-peer">单均实付</div></div>'+
    '<div class="metric-card"><div class="m-label">曝光量</div><div class="m-val num">'+(flow.exposure!=null?fmt(flow.exposure):'—（未获取）')+'</div>'+
      '<div class="m-peer">同行 '+(peer.exposure!=null?fmt(peer.exposure):'—')+'</div>'+
      (flow.exposure!=null?diffStr(flow.exposure,peer.exposure,true):'')+'</div>'+
    '<div class="metric-card"><div class="m-label">入店转化率</div><div class="m-val num">'+(flow.enter_rate!=null?pct(flow.enter_rate):'—（未获取）')+'</div>'+
      '<div class="m-peer">同行 '+(peer.enter!=null?pct(peer.enter):'—')+'</div>'+
      (flow.enter_rate!=null?diffStr(flow.enter_rate,peer.enter,true):'')+'</div>'+
    '<div class="metric-card"><div class="m-label">下单转化率</div><div class="m-val num">'+(flow.order_rate!=null?pct(flow.order_rate):'—（未获取）')+'</div>'+
      '<div class="m-peer">同行 '+(peer.order!=null?pct(peer.order):'—')+'</div>'+
      (flow.order_rate!=null?diffStr(flow.order_rate,peer.order,true):'')+'</div>'+
    '</div>';
  // 数据来源小字
  var sourceNote='<div style="font-size:11px;color:var(--text3);margin-top:8px;">'+
    '本店流量/转化数据由门店数据文件精确计算；同行对比值来自同行数据截图；客单价=单均实付；营收=门店实收收入。'+
    '门店基础数据：有效订单 <b>'+fmt(sb.valid_orders)+'</b> 单、营业额 <b>¥'+fmt(sb.gmv)+'</b>、实收 <b>¥'+fmt(sb.income)+'</b>、补贴率 <b>'+pct(sb.subsidy_rate)+'</b></div>';

  var html='';
  html+='<div style="margin-top:20px;font-size:12px;color:var(--text3);">餐谋长·AI运营诊断报告 ｜ 生成时间：'+nowStr()+' ｜ 分析功能：'+plan.name+' ｜ 消耗积分：'+plan.cost+'</div>';
  html+='<div class="sec-block"><div class="sec-title">核心指标概览</div>'+metricHtml+sourceNote+'</div>';
  html+=renderMarkdown(report);
  if(changes&&changes.length){
    html+='<div class="sec-block"><div class="sec-title">优化版菜单（'+changes.length+' 处调整）<button class="btn-mini" onclick="exportMenuXlsx()" style="height:32px;font-size:12px;color:var(--primary);border-color:var(--primary);">导出优化版菜单.xlsx</button></div>';
    html+='<div style="font-size:12px;color:var(--text3);margin-top:8px;">仅列出有明确优化价值的商品，<span class="mark-red">红色</span>标记为本次修改项；其余商品保持原样。</div>';
    html+='<div style="margin-top:10px;overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:12px;"><tr style="background:var(--bg);color:var(--text2);"><th style="padding:8px;text-align:left;border:1px solid var(--border);">商品名称</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">分组</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">原价</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">优化后名称</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">优化后描述</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">新价</th><th style="padding:8px;text-align:left;border:1px solid var(--border);">理由</th></tr>';
    changes.forEach(function(c){
      var changed=c.new_name||c.new_desc||(c.new_price!=null&&c.new_price!==c.price);
